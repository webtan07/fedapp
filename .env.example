# ── Database ──────────────────────────────────────────────────
# Neon serverless Postgres connection string (same driver as the other apps).
# FED tables live under a dedicated Postgres schema named `fed` — this keeps
# them cleanly separated from instagram-automation's `public` tables in the
# same Neon account / database.
DATABASE_URL=
# ── App ───────────────────────────────────────────────────────
# Public base URL of this app (used for absolute links / share URLs).
# Defaults to http://localhost:3101.
APP_BASE_URL=
# Port the dev/start server binds to. Defaults to 3101 (never 3000 = WDA site,
# never 3100 = IG app).
PORT=
# Stripe payment-link / checkout URL for the "Get FED" founding plan ($19
# one-time). Defaults to the real Stripe link (src/site.ts STRIPE_PAYWALL_URL)
# when unset, so local dev and the live app both point at live checkout. Set
# this only to override/relink the checkout.
PAYWALL_URL=

# ── Tester access code (free unlock, no Stripe) ────────────────
# The single shared code testers enter on the lock screen to unlock the
# paywalled app for free. Read at unlock time, so you can rotate it WITHOUT a
# redeploy. Defaults to "FEDTEST" when unset. Compared case-insensitively.
TESTER_CODE=

# ── SMTP — auto-email the FED result on quiz completion ────────
# Same Gmail app-password SMTP the WDA site uses (the business's
# admin@webdigitalassistants.com SMTP). Grab the values from the WDA site's
# .env (EMAIL_USER / EMAIL_APP_PASSWORD) — do NOT hardcode them in source.
# The From address is EMAIL_USER (admin@webdigitalassistants.com).
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Gmail defaults when unset: host smtp.gmail.com, port 465, secure true.
# Set only if you want to override the SMTP endpoint.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
