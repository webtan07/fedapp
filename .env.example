# ── Database ──────────────────────────────────────────────────
# Neon serverless Postgres connection string (same driver as the other apps).
# FED tables live under a dedicated Postgres schema named `fed` — this keeps
# them cleanly separated from instagram-automation's `public` tables in the
# same Neon account / database.
DATABASE_URL=
# ── App ───────────────────────────────────────────────────────
# Public base URL of this app (used for absolute links / share URLs).
# Defaults to http://localhost:3101.
APP_BASE_URL=
# Port the dev/start server binds to. Defaults to 3101 (never 3000 = WDA site,
# never 3100 = IG app).
PORT=
